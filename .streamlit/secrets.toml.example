# Copy to .streamlit/secrets.toml for local testing (never commit secrets.toml).
# On Streamlit Community Cloud, paste these values in App settings -> Secrets.

APP_MODE = "cloud"
DASHBOARD_PASSWORD = "choose-a-strong-password"

# Optional: only needed for local SQL Server (leave unset on Streamlit Cloud)
# DB_SERVER = "YOUR_SQL_SERVER"
# DB_NAME = "HealthAI_Project"
